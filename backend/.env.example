# ==============================================================================
# NASC Assessment Portal — Environment Configuration Template (.env.example)
# ==============================================================================

# --- System & Authentication Security ---
SECRET_KEY=your-production-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Configuration (PostgreSQL Primary) ---
DATABASE_URL=postgresql+psycopg2://<pg_user>:<pg_password>@<pg_host>:<pg_port>/<pg_database>
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Institution Master Data & Brand Identity ---
APP_NAME=MockRun
BRAND_PROVIDER=OpenLectern
INSTITUTION_NAME=Nehru Arts and Science College (Autonomous)
INSTITUTION_SHORT=NASC
CURRENT_ACADEMIC_YEAR=2026-2027
CURRENT_SEMESTER=Even Semester (III/V)

# --- Google Gemini LLM Question Generation Engine ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-flash-latest,gemini-3.5-flash

# --- Student Emails (sent from each Class Tutor's Gmail, set in the tutor panel) ---
# Sign-in link in student emails. Optional: taken from the site each tutor connects their Gmail from
PORTAL_URL=https://your-portal.example.com
# Starting password for every student loaded from a roster (they are asked to change it)
STUDENT_DEFAULT_PASSWORD=MockRun@2026
# Optional: key for encrypting tutors' Google sign-in tokens (defaults to SECRET_KEY)
EMAIL_ENCRYPTION_KEY=
# Google OAuth client (Web application) that tutors sign in with to connect their Gmail.
# Authorised redirect URI: https://<portal-domain>/api/v1/student-emails/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: force the redirect URI instead of building it from the request's host
GOOGLE_OAUTH_REDIRECT_URI=
