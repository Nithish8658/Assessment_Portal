# ==============================================================================
# NASC Assessment Portal — Environment Configuration Template (.env.example)
# ==============================================================================

# --- System & Authentication Security ---
SECRET_KEY=your-production-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Configuration (PostgreSQL Primary) ---
DATABASE_URL=postgresql+psycopg2://<pg_user>:<pg_password>@<pg_host>:<pg_port>/<pg_database>
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Institution Master Data & Brand Identity ---
APP_NAME=MockRun
BRAND_PROVIDER=OpenLectern
INSTITUTION_NAME=Nehru Arts and Science College (Autonomous)
INSTITUTION_SHORT=NASC
CURRENT_ACADEMIC_YEAR=2026-2027
CURRENT_SEMESTER=Even Semester (III/V)

# --- Google Gemini LLM Question Generation Engine ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-flash-latest,gemini-3.5-flash
